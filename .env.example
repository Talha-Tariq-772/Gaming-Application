NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIAL_ENCRYPTION_KEY=
SUPABASE_DB_PASSWORD=
CRON_SECRET=

# Gates app/api/test-only/admin-session — a dev-only route that signs a
# Playwright/agent test run into a dedicated admin fixture account so
# admin-only UI can be verified against a real session. Leave unset in
# every deployed environment (staging/production); the route already
# 404s outright when NODE_ENV=production, but this is the real backstop —
# see that route's own comment. Only ever set this in a local .env.local.
TEST_AUTH_SECRET=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
